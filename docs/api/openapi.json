  "components": {
    "schemas": {
      "AgentActionRequest": {
        "properties": {
          "action": {
            "type": "string",
            "title": "Action",
            "description": "Validated against AgentActionName on the server."
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "AgentActionRequest"
      },
      "CopilotAskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "screen": {
            "$ref": "#/components/schemas/Screen"
          },
          "patient_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patient Id"
          }
        },
        "type": "object",
        "required": [
          "question",
          "screen"
        ],
        "title": "CopilotAskRequest",
        "description": "Free text from the command bar or agent panel. Only this is routed (plan section 4.2)."
      },
      "ErrorBody": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "not_found",
          "unauthorized",
          "action_not_allowed",
          "agent_unavailable",
          "timeout",
          "not_implemented",
          "invalid_request"
        ],
        "title": "ErrorCode"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "snowflake": {
            "$ref": "#/components/schemas/HealthSnowflake"
          },
          "agent_configured": {
            "type": "boolean",
            "title": "Agent Configured"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "environment",
          "snowflake",
          "agent_configured"
        ],
        "title": "HealthResponse",
        "description": "Never contains credentials (NFR-08). Role and agent status arrive with sign-in."
      },
      "HealthSnowflake": {
        "properties": {
          "configured": {
            "type": "boolean",
            "title": "Configured"
          },
          "database": {
            "type": "string",
            "title": "Database"
          },
          "warehouse": {
            "type": "string",
            "title": "Warehouse"
          }
        },
        "type": "object",
        "required": [
          "configured",
          "database",
          "warehouse"
        ],
        "title": "HealthSnowflake"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username",
            "examples": [
              "SHARMA_DR"
            ]
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MeResponse": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "role": {
            "type": "string",
            "enum": [
              "MED_DOCTOR",
              "MED_ASSISTANT"
            ],
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "username",
          "display_name",
          "role"
        ],
        "title": "MeResponse"
      },
      "Screen": {
        "type": "string",
        "enum": [
          "dashboard",
          "patients",
          "patient",
          "knowledge",
          "activity",
          "admin"
        ],
        "title": "Screen"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ViewPreviewRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "saved_view",
              "visit_brief"
            ],
            "title": "Kind"
          },
          "patient_id": {
            "type": "string",
            "title": "Patient Id"
          },
          "content": {
            "additionalProperties": true,
            "type": "object",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "patient_id",
          "content"
        ],
        "title": "ViewPreviewRequest"
      },
      "ViewSaveRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "saved_view",
              "visit_brief"
            ],
            "title": "Kind"
          },
          "patient_id": {
            "type": "string",
            "title": "Patient Id"
          },
          "content": {
            "additionalProperties": true,
            "type": "object",
            "title": "Content"
          },
          "approved": {
            "type": "boolean",
            "title": "Approved",
            "description": "Must be true; the agent can never save on its own (FR-22)."
          }
        },
        "type": "object",
        "required": [
          "kind",
          "patient_id",
          "content",
          "approved"
        ],
        "title": "ViewSaveRequest"
      }
    }
  }
}
