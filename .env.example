# Copy to .env for local development. Never commit .env or any key file (SEC-07).
# Values marked REQUIRED-FROM-YOU are external: see docs/external-dependencies.md.

# ---- App ---------------------------------------------------------------
APP_ENV=local                      # local | test | staging | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000 # comma-separated; the UI normally proxies, so this is a fallback
# Signs the session cookie. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-change-me
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false                # true on any HTTPS deployment
REFRESH_COOKIE_PATH=/api/auth      # the UI proxy serves the API under /api; use /auth only when calling the API directly

# ---- Snowflake (REQUIRED-FROM-YOU) -------------------------------------
SNOWFLAKE_ACCOUNT=                 # <locator>.me-central2.gcp
SNOWFLAKE_WAREHOUSE=MEDYNIUM_WH
SNOWFLAKE_DATABASE=MEDYNIUM
# One key pair per app user (SEC-01). JSON map of Snowflake user -> base64 of the PEM private key:
# {"SHARMA_DR":"LS0tLS1CRUdJTi...","CLINIC_ASST":"...","SECOND_DR":"..."}
SNOWFLAKE_USER_KEYS={}
SNOWFLAKE_USER_KEY_PASSPHRASE=     # only if the private keys are encrypted

# ---- Cortex (model names confirmed in Slice 0; REQUIRED-FROM-YOU) -------
ROUTER_MODEL=llama3.1-8b           # small and cheap; never sees patient data
STRONG_MODEL=                      # strongest model available in the region, set after Slice 0
CORTEX_SEARCH_SERVICE=MEDYNIUM.KNOWLEDGE.LABEL_SEARCH
CORTEX_SEMANTIC_VIEW=MEDYNIUM.ANALYTICS.PATIENT_SEMANTIC_VIEW
CORTEX_AGENT=MEDYNIUM.ANALYTICS.MEDYNIUM_AGENT

# ---- Routing and agent behaviour ---------------------------------------
ROUTER_CONFIDENCE_THRESHOLD=0.7
ROUTER_TIMEOUT_SECONDS=5
AGENT_TIMEOUT_SECONDS=30

# ---- Setup scripts only (snowflake/, data/): never set on the deployed API ----
# MED_ADMIN is used to create objects and is not a runtime role (SEC-06).
SNOWFLAKE_ADMIN_USER=
SNOWFLAKE_ADMIN_PRIVATE_KEY_PATH=  # path to a local PEM file, kept outside the repo
SNOWFLAKE_ADMIN_ROLE=MED_ADMIN

# ---- Email (Resend) -----------------------------------------------------
# Without a key the API runs and skips sending; invitation and reset links are still returned to the admin.
RESEND_API_KEY=                    # REQUIRED-FROM-YOU: https://resend.com/api-keys
EMAIL_FROM="Medynium <onboarding@resend.dev>"  # use an address on a domain verified in Resend for real recipients
EMAIL_REPLY_TO=
LOGIN_OTP_ENABLED=false            # true: a six-digit emailed code is required after the password
OTP_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Pin the date the read models and answers are computed "as of" (YYYY-MM-DD). Leave empty to use today in IST.
# The seeded demo data is dated to 2026-10-02; live tests pin it.
DEMO_AS_OF_DATE=
